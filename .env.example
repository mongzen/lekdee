# Built-in provider: point this at the app's own loopback endpoint. A cron job
# (npm run fetch:lottery) pulls official GLO draws into data/lottery-history.json,
# and /api/internal/lottery-provider serves it in the schema this app expects.
# e.g. https://lekdee.kan.bio/api/internal/lottery-provider — see README.
LOTTERY_RESULTS_API_URL=
AI_GATEWAY_URL=
DATA_PROVIDER_TOKEN=
